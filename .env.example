# Telegram (получить на https://my.telegram.org/apps)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Telegram-бот (создать через @BotFather в Telegram: /newbot -> получишь токен)
TELEGRAM_BOT_TOKEN=

# RouterAI (провайдер по умолчанию, https://routerai.ru)
ROUTERAI_API_KEY=

# Anthropic (нужен, только если какая-то задача в config.yaml использует provider: claude напрямую)
ANTHROPIC_API_KEY=

# Gmail OAuth client secret (JSON-файл из Google Cloud Console)
GMAIL_CLIENT_SECRET_PATH=./data/gmail_client_secret.json
